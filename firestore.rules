rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidSubcollectionDoc(docId) {
      return request.resource.data.id is string &&
        request.resource.data.id == docId;
    }

    // ===============================================================
    // User-Isolated Data Rules
    // ===============================================================

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        (!('uid' in request.resource.data) ||
          request.resource.data.uid == request.auth.uid);

      match /accounts/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /transactions/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /commitments/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /savingsRules/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /pendingTransfers/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /recurringIncomes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /pendingIncomes/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /payOccurrences/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /installmentPlans/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }

      match /importedStatements/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidSubcollectionDoc(docId);
      }
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
